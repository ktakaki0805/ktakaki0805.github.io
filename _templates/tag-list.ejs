<%
// タグ一覧。タグごとに記事をまとめ、左の欄に件数つきの目次を置く。
const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const plain = (s) => esc(String(s ?? '').replace(/[*_`$]/g, ''));
const slug = (t) => 'tag-' + String(t).toLowerCase().replace(/\s+/g, '-');
const lang = templateParams?.lang || 'ja';
const en = lang === 'en';
const posts = items.filter((item) => (item.lang || 'ja') === lang);

const groups = {};
for (const item of posts) for (const c of (item.categories || [])) (groups[c] = groups[c] || []).push(item);
const tags = Object.keys(groups).sort((a, b) => groups[b].length - groups[a].length || a.localeCompare(b, lang));
// Keep tag anchors usable when switching between translated category names.
const aliases = {};
const assignedAliases = new Set(tags.map(slug));
for (const item of items) {
  (item.categories || []).forEach((name, i) => {
    const translated = (item['categories-en'] || [])[i];
    if (!translated) return;
    const canonical = en ? translated : name;
    const alias = slug(en ? name : translated);
    if (groups[canonical] && !assignedAliases.has(alias)) {
      (aliases[canonical] ||= []).push(alias);
      assignedAliases.add(alias);
    }
  });
}
%>
```{=html}
<div class="home-grid column-page-left">
<nav class="home-nav" aria-label="<%= en ? 'Tags' : 'タグ一覧' %>">
<ul class="tag-index">
<% for (const t of tags) { %>
<li><a href="#<%= esc(slug(t)) %>"><span><%= esc(t) %></span><span class="count"><%= groups[t].length %></span></a></li>
<% } %>
</ul>
</nav>
<div class="tag-sections">
<% if (!tags.length) { %>
<p class="post-list-empty"><%= en ? 'No tags in English yet.' : 'まだタグはありません。' %></p>
<% } %>
<% for (const t of tags) { %>
<section class="tag-section" id="<%= esc(slug(t)) %>">
<% for (const alias of (aliases[t] || [])) { %><span id="<%= esc(alias) %>" aria-hidden="true"></span><% } %>
<h2 class="tag-section-title"><span><%= esc(t) %></span><span class="count"><%= groups[t].length %><%= en ? (groups[t].length === 1 ? ' post' : ' posts') : '件' %></span></h2>
<ol>
<% for (const item of groups[t]) { %>
<li>
<a class="tag-item" href="<%- item.path %>">
<span class="tag-item-date"><%= esc(item.date) %></span>
<span class="tag-item-title"><%= plain(item.title) %></span>
</a>
</li>
<% } %>
</ol>
</section>
<% } %>
</div>
</div>
```
